{
  "expo": {
    "name": "FLOWVISION",
    "slug": "flowvision",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "flowvision",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050B0E",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B0E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.flowvision.field",
      "versionCode": 12,
      "backgroundColor": "#050B0E",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#050B0E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FLOWVISION uses the camera to record surface-velocity video and pipe-face level photos. Video is recorded without audio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FLOWVISION imports existing videos and photos from your device to analyse them locally."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FLOWVISION records a foreground GPS fix with a measurement when you ask it to. Location stays on the device.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-sqlite",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "ozren1983",
    "extra": {
      "eas": {
        "projectId": "dca30216-1056-4c1d-b155-09999df2a777"
      }
    }
  }
}
